Object -> BlueBook "libro blu" class Book
	with
		name 'libro' 'blu',
		time_left 0,
		initial [;
			!print "Self is ", self, ". ";
			!if(BlueBook provides hello && BlueBook.hello > 10) {
			!	print "BlueBook.Hello is ", BlueBook.hello, ". ";
			!}
			print "Un ";
			PrintShortName(self);
			" riposa su uno scaffale. Guardare ", (the) self, " ti disorienta.";
		],
		before [;
			Turn:
				"Giri il libro ancora ed ancora. Divertimento assicurato. ";
		],
		after [;
!            Drop:
!               StopDaemon(Self);
			Take:
				if(RedBook in player) {
					print "Il libro rosso non vuole stare accanto al libro blu e decide di sfuggirti, cadendo sul pavimento.^^";
					move RedBook to location;
                }
!                StartDaemon(LargeBox);
                StartDaemon(self);
				self.time_left = turns; ! Remember which turn we started
                StartTimer(LargeBox, 3);
				print "Il libro blu comincia a ticchettare...^";
				rtrue; ! stop normal printouts
		],
!		description "Il libro sembra nuovo e lucido.",
        daemon [;
			if(self.time_left < turns - 1) {
				if(TestScope(self))
	            	print "^Il libro blu sta ticchettando sonoramente.^";
				else
	        		print "^Senti un remoto, flebile ticchettìo.^";
			}
        ],
		bobby 7,
		hello 13,
		timer_order 190,
		pants (-1000) (-1001) (-1002) (-1003) (-1004) (-1005) (-1006) (-1007) (-1008) (-1009) (-1010) (-1011) (-1012) (-1013) (-1014) (-1015) (-1016) (-1017) (-1018) (-1019) (-1020) (-1021) (-1022) (-1023) (-1024) (-1025) (-1026) (-1027) (-1028) (-1029) (-1030) (-1031),
	has light; ! well, it is glowing

