!% -~S
!% -e
!% $OMIT_UNUSED_ROUTINES=1
!% $ZCODE_LESS_DICT_DATA=1

! Testbench - a platform for trying things out in PunyInform

! compile as z8 to use Inform stdlib instead of puny (for debugging)
#Iftrue (#version_number == 8);
Constant USEINFORM;
#Endif;

! Uncomment ONE of the two following lines, to show either time or score/turns
! Leaving both commented out makes the library bigger.
Statusline time;
!Constant STATUSLINE_SCORE; Statusline score;

Constant RUNTIME_ERRORS = 0; ! 0 = Minimal error checking, 1 = Numeric error codes, 2: Error messages

#IfnDef USEINFORM;
! Uncomment to add optional features to PunyInform
!Constant OPTIONAL_NO_DARKNESS;
Constant STATUSLINE_TIME;
Constant OPTIONAL_ALLOW_WRITTEN_NUMBERS;
Constant OPTIONAL_FLEXIBLE_INVENTORY;
Constant OPTIONAL_EXTENDED_METAVERBS;
Constant OPTIONAL_EXTENDED_VERBSET;
!Constant OPTIONAL_LANGUAGE_NUMBER;
!Constant OPTIONAL_LIST_TOGETHER;
Constant OPTIONAL_PRINT_SCENERY_CONTENTS;
Constant OPTIONAL_SCORED;
Constant OPTIONAL_FULL_SCORE;
Constant OPTIONAL_GUESS_MISSING_NOUN;
Constant OPTIONAL_FULL_DIRECTIONS;
Constant OPTIONAL_SIMPLE_DOORS;
Constant OPTIONAL_SHIP_DIRECTIONS;
Constant OPTIONAL_MANUAL_SCOPE;
Constant OPTIONAL_MANUAL_REACTIVE;
Constant OPTIONAL_REACTIVE_PARSE_NAME;
Constant OPTIONAL_ORDERED_TIMERS;
Constant MAX_SCOPE = 50;

#Iftrue (#version_number == 5);
Constant OPTIONAL_PROVIDE_UNDO;
#Endif;

Constant INITIAL_LOCATION_VALUE = Library;

!Constant DEBUG; ! Provides debug verbs for both Inform and PunyInform
!Constant DEBUG_PARSEANDPERFORM;
!Constant DEBUG_PARSEPATTERN;
!Constant DEBUG_PARSETOKEN;
!Constant DEBUG_PARSENOUNPHRASE;
!Constant DEBUG_GETNEXTNOUN;
!Constant DEBUG_SCOPE;
!Constant DEBUG_TIMER; ! requires special Ozmoo
#EndIf;

!Constant TEST_BEFOREAFTER;

Constant Story      "Testbench";
Constant Headline   "^Una sandbox per lo sviluppo di PunyInformIT^";

#IfDef DEBUG_TIMER;
Serial "999999"; ! Serial "999999" enables timing in Ozmoo, meaning that the RTC (jiffies since start) can be read from $1c-->0
#EndIf;

Constant DEATH_MENTION_UNDO;
Constant MAX_CARRIED 3;
Constant SACK_OBJECT infiniteBag;

Constant AMUSING_PROVIDED;

#IfDef OPTIONAL_FULL_SCORE;
Constant MAX_SCORE = 7;
Constant OBJECT_SCORE = 1;
Array task_scores -> 3 0; ! inform doens't like array of length 1
Constant TASKS_PROVIDED;
Constant NUMBER_TASKS = 1;
#IfNot;
Constant MAX_SCORE = 3;
#EndIf;

[ Amusing;
	"^Hai provato a spingere John tante volte? Uscire e guardare il sole?";
];

! Setup cheap scenery
[SceneryReply w1 w2;
	Push:
		if(w1=='uccello' && w2=='uccelli') "Gli uccelli volano via appena ci provi.";
		"E come riusciresti a farlo?";
	default:
		rfalse;
];


! Setup flags
Constant FLAG_COUNT 8;
!Constant F_SQUIRREL_ESCAPED 0;
!Constant F_PARROT_FED 1;
!Constant F_BOUGHT_TICKETS 2;

#IfDef TEST_BEFOREAFTER;
[LookRoutine;
	"***** LookRoutine, yay!";
];
#EndIf;


#Ifdef USEINFORM;
Include "Parser";

Attribute reactive;

Include "VerbLib";
Include "ext_cheap_scenery.h";
Include "ext_flags.h";

#IfNot;
Include "globals.h";
#EndIf;

[ApertoChiuso obj; 
    if(obj has open) print "aperto";
    else print "chiuso";
    return;
];

[ChooseObjects obj code;
	if(code == 2) {
		if(action_to_be == ##SwitchOn or ##SwitchOff) {
			if(obj has switchable)
				return 2;
		}
		return 0;
	}
!	print " ALL:", (name) obj;
	rfalse; ! Don't interfere with ALL
];

[InScope p_actor;
	if(p_actor == player && location == thedark && John in real_location)
		PlaceInScope(John);
	rfalse;
];

[ParseNoun obj w;
	if(obj == LargeBox) {
		w = NextWord();
		if(w == 'baule') { wn = wn + 7; return 1; } ! Change wn just to check that nothing breaks
		if(w == 'grande') return -1;
		wn--;
	}
	if(obj == PinkBook) {
		w = NextWord();
		if(w == 'piccolo') return -1;
		wn--;
	}
	return -1;
];

[ DarkToDark;
	deadflag = 1;
	"Sei stato mangiato da una grue.";
];

[ PrintRank;
  print ", guadagnando il rango di ";
  if (score >= 3) "Cacciatore di tesori.";
  if (score >= 2) "Esploratore.";
  "Turista.";
];
[ PrintTaskName task_number;
  switch (task_number) {
      0: "aprendo la scatola";
  }
];


#Ifndef USEINFORM;
Include "ext_cheap_scenery.h";
Include "ext_flags.h";
!Include "ext_talk_menu.h";
Constant EXT_MENU_STDLIB_MODE;
Include "ext_menu.h";

! Setup custom library messages
Constant MSG_OPEN_YOU_CANT 1000;
Constant MSG_AREYOUSUREQUIT 1001;
Constant MSG_DISROBE_NOT_WEARING 1002;
Constant MSG_LOOK_BEFORE_ROOMNAME 1003;
[LibraryMessages p_msg p_arg_1 p_arg_2;
	switch(p_msg) {
	MSG_OPEN_YOU_CANT:
		"E come pensi di aprire ", (a) noun, "?";
	MSG_AREYOUSUREQUIT:
		print "Non sei uno che si arrende, eh? ";
		rtrue;
	MSG_DISROBE_NOT_WEARING:
		"Non è indossato!";
	MSG_LOOK_BEFORE_ROOMNAME:
		if(turns >= 0) new_line;
	}
	p_arg_1 = 0; p_arg_2 = 0; ! To avoid warnings
];



[DisallowTakeAnimate;
	if(noun == Lizard) rfalse;
];



Include "puny.h";

Include "ext_waittime.h";

#Endif;

[ HelpItems;
    print "Ci sono informazioni per te su:^^";
    print "      Istruzioni^";
    print "      Scopo del gioco^";
    print "      Crediti^";
];

[ HelpMenu;
! Note that we set item_width to half the length of each name, since we have
! defined EXT_MENU_STDLIB_MODE to make ext_menu fully compatible with the
! standard library DoMenu implementation.
    switch(menu_item) {
    0: item_width=10; item_name="Aiuto e informazioni"; return 3;
    1: item_width=5; item_name="Istruzioni";
    2: item_width=8; item_name="Scopo del gioco";
    3: item_width=4; item_name="Crediti";
    }
];

[ HelpInfo;
    switch(menu_item) {
    1: "Si gioca come un vecchio gioco infocom.^^I comandi più comuni includono: esamina, apri, chiudi, salva, carica, termina.";
    2: "Questo è un gioco di test";
    3: "Questo è stato creato da noi";
    }
];

[ HelpSub;
    DoMenu(HelpItems, HelpMenu, HelpInfo);
];
Verb 'aiuto' * -> Help;



Extend 'parla' replace
	*	'a//'/'a*'/'con'	creature	-> Talk;

[TalkSub;
	if (noun == player) "La conversazione è poco interessante.";
	if (RunLife(noun,##Talk) ~= false) return;
	"Non hai niente da dire.";
];

[ScanScope;
	switch(scope_stage) {
		1: rfalse;
		2: ScopeWithin(RiverBank); rtrue;
		3: "Sei folle!";
	}
];

[BangParse;
#Ifdef USEINFORM;
	return ParseToken(ELEMENTARY_TT, NUMBER_TOKEN);
#Ifnot;
	return ParseToken(TT_OBJECT, NUMBER_OBJECT);
#Endif;
];

Verb 'spara'
	* BangParse -> Bang;

[BangSub;
	"Il nome è ", parsed_number, ".";
];

[WowScope;
	switch(scope_stage) {
		1: rfalse;
		2: ScopeWithin(CarPark); rtrue;
		3: "Non puoi sbalordirti per questo, è ridicolo!";
	}
];

[WowParse x;
#Ifdef USEINFORM;
	x = ParseToken(SCOPE_TT, WowScope);
#Ifnot;
	x = ParseToken(TT_SCOPE, WowScope);
#Endif;
	print "ParseToken ha ritornato ", x, "^";
	return x;
];

Verb 'sbalordisci'
	* 'per' WowParse -> Wow;

[WowSub;
	print (The) noun, " è in vista!^";

!	LoopOverScope(WowLoop);
];

Verb 'sfoglia'
	* scope=ScanScope -> Scan
	*  noun 'locale' -> Scan;

[ScanSub;
	if(AfterRoutines()) rtrue;
	print "Sfogliando ", (the) noun, "... Ok!^";
];

Verb 'spiffera'
	* number 'to' topic -> Telly;

[ TellySub;
	"Tu spifferi ", noun, " a ", (address) second, ".";
];

Constant SCN_WATER = "L'acqua è così bella in questa stagione, così trasparente e sbrilluccicosa.";
[SCN_SUN;
	Examine:
	  deadflag = 1;
	  "Mentre fissi il sole, senti una sensazione di bruciore nei tuoi occhi.
	    Dopo un pò tutto si fa nero. Senza la vista non hai molte speranze di
	    completare la tua investigazione.";
	default:
		! Since this is a named routine, it will return true by default. Thus we
		! have to return false for all actions we don't care about
		rfalse;
];

Class Book
	with
		name 'libri//p',
		description [;
			print "Il soggetto è ", self, "^";
			if(self provides hello) {
				print (The) self, " ha un valore Saluto di ", self.hello, ". ^";
			}
			rfalse;
		],
		hello 0,
		party [a;
			print "Il soggetto è ", self, "^";
			print "a is ", a, "^";
!			print "b is ", b, "^";
!			print "c is ", c, "^";
		],
		before [;
			Open:
				"Non sei mai stato un gran lettore.";
		],
	has openable;

Object CarPark "Parcheggio"
	with
		!short_name [; print "In front of the library!"; rtrue; ],
		initial "Apperò, questo è un immenso parcheggio!",
		description [;
			"Sei nel parcheggio di fronte alla libreria.
			Puoi entrare a nord. C'è un fiume a est.
			A sud vedi l'insegna di Alfa Riparazioni.
			Un tavolo è inspiegabilmente messo nel bel mezzo del parcheggio.
			Uno strano odore permea l'aria.";],
		n_to Library,
		sw_to [; "C'è un dragone arrabbiato che ti sbarra la via!"; ],
		e_to RiverBank,
		s_to AlphaRepair,
		each_turn [;
			print (string) random(
					"^Un gufo sta bubolando nei paraggi.",
					"^Un urlo terribile proviene dalla libreria.",
					"^Un suono di tanti uccelli proviene da est.");
			"";
		],
		scenery_outdoors
			CS_NO_ADJ 'air' "L'aria è fresca qui!"
            'soil' 'dirt' "La terra è umida dopo una notte di pioggia.",
		cheap_scenery
			CS_NO_ADJ 'library' [;
				Examine: "È una libreria molto carina.";
				Burn: "Meglio di no!";
			]
			CS_PARSE_NAME [ i;
			    while(NextWord() == 'favoloso' or 'immenso' or 'parcheggio') i++; return i;]
			  "Un favoloso, immenso parcheggio!"
			'strano' 'odore' "Come quello di una puzzola."
            'suolo' 'terra' "Il terriccio è stranamente asciutto qui!"
			CS_ADD_LIST CarPark (scenery_outdoors),
#IfDef TEST_BEFOREAFTER;
		after [; print "*** CarPark.after^"; ],
		before [; print "*** CarPark.before^"; ],
#EndIf;
		cant_go "Senza un'auto, puoi solo andare a nord.",
#IfDef OPTIONAL_FULL_SCORE;
	has scored light reactive;
#IfNot;
	has light reactive;
#EndIf;

Object -> Blue  "tavolo blu"
	with
		name 'tavolo' 'blu',
		has supporter scenery;

Object -> Table "tavolo"
	with
		name 'tavolo',
		has supporter scenery;

Object -> -> "piatto palese"
	with
		name 'piatto' 'palese';

Object -> -> "piatto occulto"
	with
		name 'piatto' 'occulto'
	has concealed;


Object -> Key "chiave"
	with
		description "È una chiave di metallo, con un portachiavi attaccato.",
		name 'chiave' 'metallo',
#IfDef TEST_BEFOREAFTER;
		after [; print "*** Key.after^"; ],
		before [; print "*** Key.before^"; ],
#EndIf;
	has transparent
#IfDef OPTIONAL_FULL_SCORE;
	scored
#EndIf;
	has female;

Object -> -> Keyring "portachiavi"
	with
		name 'portachiavi',
		description "Un comune portachiavi.";

Object -> LeadWeight "peso di piombo"
	with
		name 'peso' 'di' 'piombo',
		before [;
		Drop:
			remove self;
			move pencil to parent(player);
			PronounNotice(pencil);
#IfDef OPTIONAL_MANUAL_SCOPE;
			scope_modified = true;
#EndIf;
			"Quando un peso di piombo cade, fa un rumore differente.";
		]
	;

Object Pencil "matita"
	with name 'matita' has female;

Object car "piccola auto rossa" CarPark
	with name 'piccola' 'auto' 'rossa',
		description "Larga abbastanza per sedervisi. Tra i controlli c'è un
			prominente interruttore on/off. La targa è KAR 1.",
		describe [;
			@new_line;
			if(self has on) {
				"L'auto è qua col motore ancora acceso.";
			} else {
				"Una piccola auto rossa è parcheggiata qui.";
			}
		],
		!when_on "The red car sits here, its engine still running.",
		!when_off "A little red car is parked here.",
		before [;
			Go: if (car has on) "Brum! Brum!";
				print "(L'auto è spenta al momento.)^";
		],
	has female switchable enterable static container open;

Object RiverBank "Riva del fiume"
  with
		description "Il fiume è molto largo qui. Il sole riflette l'acqua blu, 
			gli uccelli volano alti.",
	  	d_to SecretHatch,
		w_to CarPark,
		nw_to Library,
		cheap_scenery
			'acqua' 'blu' SCN_WATER
			'uccello' 'uccelli' "Sono così spensierati."
			CS_NO_ADJ 'sole' SCN_SUN
			CS_ADD_LIST CarPark (scenery_outdoors),
	has light;

Object -> ExoSkeleton "esoscheletro"
	with
		description "Un'esoscheletro potenziato, progettato per dare poteri sovrumani
		a chi lo utilizza. Puoi entrare nell'esoscheletro.",
		name 'eso' 'esoscheletro' 'scheletro',
	has enterable transparent;

Object -> Microphone "microfono"
	with
		name 'microfono',
		orders [;
			"~Non sono ai tuoi ordini!~ dice il microfono.";
		],
		before [;
			Ask:
				print "Before: Microphone - Ask^";
			AskFor:
				print "Before: Microphone - AskFor^";
			Answer:
				print "Before: Microphone - Answer^";
			Tell:
				print "Before: Microphone - Tell^";
		],

		life [;
			Ask:
				"Life: Microphone - Ask";
			AskFor:
				"Life: Microphone - AskFor";
			Answer:
				"Life: Microphone - Answer";
			Tell:
				"Life: Microphone - Tell";
		],
	has talkable;

Object -> SecretHatch "botola segreta"
	with
		name 'botola' 'segreta',
		description "È molto segreta.",
		after [;
			give self ~concealed;
		],
		door_to Library,
		door_dir (d_to),
	has female static concealed door openable;

Object -> Lizard "graziosa piccola lucertola"
	with
		name 'graziosa' 'piccola' 'lucertola',
		description "Ti guarda con due occhioni.",
		after [;
			Take:
				"Si tuffa nel tuo taschino, rigirandosi un pò, 
				poi sbuca fuori, pronta per l'avventura!";
			Drop:
				deadflag = 1;
				"Salta fuori e ti morsica la mano. Sei morto/a.";
		],
	has female animate;

Object -> paper "giornale"
	with
	 	name 'giornale',
		describe "^C'è un giornale qui.";

Object -> paperclip "fermaglio"
	with
	 	name 'fermaglio',
		describe "^C'è un fermaglio qui.";

Object AlphaRepair "Alfa Riparazioni"
	with
		description "Sei presso l'Alfa Riparazioni. Il parcheggio sta a nord,
			mentre l'officina Beta Riparazioni sta a sud. L'insegna Alfa Riparazioni e
			il nastro trasportatore sono le due cose prominenti qui.",
		n_to CarPark,
		s_to BetaRepair,
		repair_name 'alfa',
		cheap_scenery
			CS_PARSE_NAME
				[ i;
					while(NextWord()==self.repair_name or 'riparazioni' or 'pannello')
						i++;
					return i;
				]
				[; Examine: "Il pannello ", (address) self.repair_name, " riparazioni sembra ok."; ]
			'nastro' 'trasportatore' "Non sembra guasta.",
	has female light;

Object BetaRepair "Beta Riparazioni"
	with
		description "Sei presso la Beta Riparazioni. Alfa Riprazioni sta a nord.
			L'insegna Alfa Riparazioni e il nastro trasportatore sono le due cose prominenti qui.",
		n_to AlphaRepair,
		repair_name 'beta',
		cheap_scenery CS_ADD_LIST AlphaRepair (cheap_scenery),
	has female light;

Object Toilet "Il bagno"
	with
		short_name [; print "Un bagno"; rtrue; ],
		description[;
			print "Questo bagno ha bisogno di una bella lavata. La porta
			si trova a ovest, e riporta alla libreria.
				C'è un oscuro passaggio a est.";
			if(Faucet has open) {
				"L'acqua scorre dal rubinetto. ";
			}
			"";
		],
#IfDef USEINFORM;
		w_to Library,
#IfNot;
		w_to ToiletDoor,
#EndIf;
		e_to DarkChamber,
	has ~light;

Object -> ToiletDoor "porta del bagno"
	with
		name 'porta' 'di*' 'bagno',
		describe [; rtrue; ],
!		parse_name [ _w;
!			_w = NextWord();
!			if(_w == 'toilet') {
!				_w = NextWord();
!				if(_w == 'door')
!					return 2;
!				return 0;
!			}
!			if(_w == 'door')
!				return 1;
!		],
		description "Pulita, stranamente.",
		when_open "La porta del bagno rimane socchiusa.",
		when_closed "La porta del bagno è chiusa.",
#IfDef USEINFORM;
		door_to [;
			if(self in Toilet) return Library;
			return Toilet;
		],
		door_dir [;
			if(self in Toilet) return w_to;
			return e_to;
		],
#IfNot;
		door_dir (w_to) (e_to),
#EndIf;
		found_in Toilet Library,
		with_key [; if(second == Key or Sweater) return second;],
#IfDef TEST_BEFOREAFTER;
		after [; print "*** ToiletDoor.after^"; ],
		before [; print "*** ToiletDoor.before^"; ],
#EndIf;
	has female door openable static lockable;

Object -> Goblin "Goblin"
	with
		short_name "Goblin",
		description "È una creatura dall'aspetto cattivo, meglio starci alla larga. ",
		name 'goblin' 'creatura',
		before[;
			Attack:
				print "Ma ha una sciabola minacciosa e tu sei indifeso. Sei proprio sicuro? ";
				if(YesOrNo()) {
					deadflag = 1;
					"Non pensavi che il tuo corpo potesse contenere così tanto sangue. ";
				} else {
					"Saggia decisione.";
				}

!				rtrue;
		],
	has animate;


Object -> Sink "Lavabo"
	with
		short_name "lavabo",
		name 'lavabo' 'acqua',
		description[;
			print "È un normale lavabo bianco con un rubinetto apribile.";
			if(Faucet has open)
				" L'acqua scorre dal rubinetto.";
			"";
		],
	has container static scenery;

Object -> Faucet "rubinetto"
	with
		short_name "rubinetto",
		name 'rubinetto',
		description[;
			print "È un rubinetto apribile. ";
			"Al momento è ", (ApertoChiuso) self, ".";
		],
	has openable static scenery;

Object DarkChamber "Camera Oscura"
	with
		description "È quasi completamente buia.",
		w_to Toilet
		has female;

Object Library "La Libreria"
	with
		name 'libreria', ! should create "you don't need to refer to ..."
		short_name [; print "Immensa libreria"; rtrue; ],
		description "Sei in un'antica e desolata libreria. C'è un'uscita a sud. Il bagno è a est.",
		s_to CarPark,
		se_to RiverBank,
#IfDef USEINFORM;
		e_to Toilet,
#IfNot;
		e_to ToiletDoor,
#EndIf;
#IfDef TEST_BEFOREAFTER;
		after [; print "*** Library.after^"; ],
		before [; print "*** Library.before^"; ],
#IfNot;
		before [;
			Look:
				if(self hasnt general) {
					give self general;
					!QuoteBox(quote_1);
				}
		],
#EndIf;
	has female light;

Object -> Dial "manopola"
	with
		name 'manopola' 'nera',
		initial "C'è una manopola nera sul muro.",
		description [;
			print "Va da 0 a 99. Ora è su ",
					self.time_left, ".^";
		],
		time_left 0,
		before [;
			Turn, Push, Pull: "Prova IMPOSTA MANOPOLA SU 3.";
			SetTo:
				if(second >= 0 && second < 100) {
					if(HDR_GAMEFLAGS-->0 & 128) {
						! sound effect: 3, start, full volume, once
						print "[Puoi sentire il cicalino?]^^";
						@sound_effect second 2 255 0;
					}
					self.time_left = second;
					"Ok.";
				}
				"Va solo da 0 a 99.";
		],
	has female static;


Object -> LightSwitch "interruttore della luce"
	with
		short_name "interruttore della luce",
		description "È un interruttore vicino al bagno. ",
		name 'interruttore' 'di*' 'luce',
		before [;
			Push:
				if(self has on) {
					<<SwitchOff self>>;
				} else {
					<<SwitchOn self>>;
				}
		],
		after[;
			SwitchOn:
				give toilet light;
#IfnDef USEINFORM;
				ship_directions_enabled = true;
				"Accendi l'interruttore. Ora le direzioni navali funzionano.";
#Endif;
			SwitchOff:
				give toilet ~light;
#IfnDef USEINFORM;
				ship_directions_enabled = false;
				"Spegni l'interruttore. Ora le direzioni navali non funzionano più.";
#Endif;
		],
	has apostrofo switchable static;


Object -> Sweater "felpa"
	with
		name 'felpa' 'rossa',
	with before [;
		Wear:
			if(PinkBook in player)
				"Spiacente, porta sfortuna indossare vestiti con il libro rosa in mano.";
