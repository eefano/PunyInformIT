! questo è un test di manipolazione di oggetti multipli (palle/monete)
! Bug risolti/analizzati con questo file
! - "lascia monete" quando non possiedi nessuna palla
!
!
Constant Story      "Test del parser";
Constant Headline   "^Una suite di test per PunyInformIT.^";
Serial "200913";

Constant INITIAL_LOCATION_VALUE = BallRoom;

! Uncomment to show time instead of score/turns
!Statusline time;

!Constant DEBUG_PARSEANDPERFORM;
!Constant DEBUG_PARSEPATTERN;
!Constant DEBUG_PARSETOKEN;
!Constant DEBUG_PARSENOUNPHRASE;
!Constant DEBUG_GETNEXTNOUN;
!Constant DEBUG_SCOPE;

! Uncomment to add optional features to PunyLib
!Constant DEBUG;
!Constant CUSTOM_ABBREVIATIONS;
!Constant OPTIONAL_ALLOW_WRITTEN_NUMBERS;
Constant OPTIONAL_EXTENDED_METAVERBS;
!Constant OPTIONAL_EXTENDED_VERBSET;
!Constant OPTIONAL_FULL_SCORE;
!Constant OPTIONAL_FULL_DIRECTIONS;
!Constant OPTIONAL_GUESS_MISSING_NOUN;
!Constant OPTIONAL_MANUAL_SCOPE;
!Constant RUNTIME_ERRORS = 0;

Include "globals.h";

! Uncomment to add PunyLib extensions
!Include "ext_menu.h";
!Include "ext_flags.h";
!Include "ext_quote_box.h";
!Include "ext_cheap_scenery.h";

Include "puny.h";

Class Ball
	with
		adj1 'palla',
		adj2 'palla',
		adj2p 'palla',
		short_name [; print "palla ", (address) self.adj1, " ", (address) self.adj2 ; rtrue; ],
		parse_name [ i;
			while(NextWord() == 'palla' or 'palle//p' or self.adj1 or self.adj2 or self.adj2p) i++;
			return i;
		],
		has female;

Object BallRoom "Stanza Delle Palle"
	with
		description [;
			print "Sei nella stanza delle palle. La stanza della pendenza sta a est.
				La stanza bianca sta a sud.
				C'è dell'aria nella stanza.";
			if(BlackBall in self && BlackBall has concealed)
				print " Potrebbe esserci una palla nera nell'angolo, ma non sei sicuro.";
			"";
		],
		e_to SlopingRoom,
		s_to WhiteRoom,
	has female light;

Object -> Air "aria"
	with name 'aria'
	has female scenery;

Object -> Table "tavolo"
	with
		name 'blu' 'tavolo',
		description [;
			print "È un bel tavolo robusto, tutto dipinto di blu.";
			self.show_contents();
			@new_line;
		],
		initial [;
			print "C'è un tavolo nero nel mezzo della stanza.";
			if(~~IndirectlyContains(self, player)) self.show_contents();
			@new_line;
		],
		show_contents [;
			if(PrintContents(" Sul tavolo puoi vedere ", self)) print ".";
		],
	has static supporter enterable;

Ball -> BlueBall with adj1 'mini', adj2 'blu';

Ball -> RedBall with adj1 'mini', adj2 'rossa', adj2p 'rosse';

Ball -> GreenBall with adj1 'mini', adj2 'verde', adj2p 'verdi';

Ball -> BlackBall with adj1 'mini', adj2 'nera', adj2p 'nere' has concealed;

Object -> BlackCoin "moneta nera"
	with
		name 'nera' 'nere//p' 'moneta' 'monete//p',
		has female;

Object -> RedCoin "moneta rossa"
	with
		name 'rossa' 'rosse//p' 'moneta' 'monete//p',
		has female;

Object SlopingRoom "Stanza Della Pendenza"
	with
		description "La stanza pende a ovest verso la stanza delle palle.",
		after [;
			Drop:
				if(noun ofclass Ball) {
					move noun to BallRoom;
					scope_modified = true;
					print_ret (The) noun, " rotola via verso ovest.";
				}
		],
		w_to BallRoom,
		has female light;

Object WhiteRoom "Stanza Bianca"
	with
		description "È tutta bianca. La stanza delle palle sta a nord.",
		n_to BallRoom,
	has female light;

Object -> RedBox "scatola rossa"
	with
		inside_description "You notice that the box is red on the inside too.",
		name 'scatola' 'scatole//p' 'rossa',
	has female container open openable enterable;

Object -> TransparentBox "scatola trasparente"
	with
		inside_description "La scatola trasparente sembra confortevole.",
		name 'scatola' 'scatole//p' 'trasparente',
	has female container open openable transparent enterable;

[Initialise;
	print "^^Partenza!^^";
	return 2;
];
