!% -Cu
!% -~S
!% $OMIT_UNUSED_ROUTINES=1
!% $ZCODE_LESS_DICT_DATA=1

Constant Story      "Aggettivi";
Constant Headline   "^Un test per PunyInformIT.^";

Constant STATUSLINE_SCORE; Statusline score;

! Uncomment to add optional features to PunyInform
!Constant DEBUG;
Constant OPTIONAL_NO_DARKNESS;
!Constant RUNTIME_ERRORS = 0; ! 0, 1 or 2. 0 = smallest file, 2 = most info

Constant OPTIONAL_EXTENDED_METAVERBS;
Constant OPTIONAL_EXTENDED_VERBSET;

Constant INITIAL_LOCATION_VALUE = Library;

Include "globals.h";

Include "puny.h";

! -------------------- Copy the following code to your own game

#Ifv5;
Property adj_name;
Property noun_name;
#Ifnot;
Property individual adj_name;
Property individual noun_name;
#Endif;

#Ifv5;
[MatchNameList p_obj p_prop _w _matched _an _count _i;
#Ifnot;
[MatchNameList p_obj p_prop _w _matched _base _an _count _i;
#Endif;
    _w = NextWord();
    _an = p_obj.&p_prop;
    if(_an == 0) return 0;
    _count = p_obj.#p_prop / 2;
    while(true) {
#Ifv5;
		@scan_table _w _an _count -> _i ?_MNL_match;
		return _matched;
._MNL_match;
		_matched++;
		_w = NextWord();
#Ifnot;
        _base = _matched;
        for(_i = 0 : _i < _count : _i++)
            if(_w == _an-->_i) { _matched++; _w = NextWord(); break; }
        if(_matched == _base) return _matched;
#Endif;
    }
];

Class AdjObject
    with
        parse_name [ _adj _noun;
            _adj = MatchNameList(self, adj_name);
            wn--;
            _noun = MatchNameList(self, noun_name);
            if(_noun) return _noun + _adj;
        ];

! -------------------- End of code to copy


Object Library "Libreria"
	with
		description "Sono in libreria.";

Object -> Box "scatola"
	with
		name 'scatola',
		inside_description "Scatolaccia.",
	has female container open openable enterable;

Object -> RecordPlayer "gran bel porta disco"
    class AdjObject
    with
        adj_name 'gran' 'bel' ,
        noun_name 'porta' 'disco',
		description "Un porta disco da paura.",
    has static;

Object -> Record "disco"
    with
        name 'disco',
		description "The Dark Side Of The Moon, dei Pink Floyd.";

Extend 'riproduci' first
	* held 'su'/'su*' noun -> Play;

[PlaySub;
	if(noun notin player) "Non possiedi ", (the) noun, ".";
	if(noun ~= Record)
		"Non è qualcosa di riproducibile.";
	if(second ~= RecordPlayer)
		"Non puoi riprodurlo su questo!";
	"Suona una meraviglia!";
];
	
[Initialise;
	print "^^
La classe AdjObject consente di definire fino a 32 aggettivi e
	32 sostantivi per un oggetto, in qualsiasi versione di Z-code. 
	Questa funzione può essere utilizzata per aggiungere
	molti sinonimi come sostantivi e/o per definire alcune parole come aggettivi.
	Gli aggettivi sono parole che possono essere utilizzate per riferirsi all'oggetto, 
	ma solo sesono seguite da uno o più sostantivi.^^
	In questo esempio, DISCO si riferisce al disco, mentre PORTA DISCO
	si riferisce al portadisco, e non vi è alcuna ambiguità. È anche possibile riferirsi
	al portadisco come BEL PORTA o BEL PORTA DISCO o semplicemente PORTA.
	In italiano difficilmente ci sarà quest'ambiguità, è solo per dimostrare la funzione,
	(anche perché sarebbe difficile uscire da questa stanza senza una porta :D)^^";
]; 
