!% -Cu
!% -~S
!% $OMIT_UNUSED_ROUTINES=1
!% $ZCODE_LESS_DICT_DATA=1


Constant Story      "Test PrintContents";
Constant Headline   "^Un test per PunyInformIT.^";

! Uncomment ONE of the two following lines, to show either time or score/turns
! Leaving both commented out makes the library bigger.
!Constant STATUSLINE_TIME; Statusline time;
Constant STATUSLINE_SCORE; Statusline score;

! Comment out to keep track of score
! The value is what will be shown as the score on statusline in z3
Constant NO_SCORE = 0;

! Customize the statusline in z5+ (will have no effect in z3)
!Constant OPTIONAL_SL_NO_SCORE;
!Constant OPTIONAL_SL_NO_MOVES;

! Uncomment to add optional features to PunyInform
!Constant DEBUG;
Constant OPTIONAL_NO_DARKNESS;
Constant OPTIONAL_EXTENDED_METAVERBS;
!Constant OPTIONAL_EXTENDED_VERBSET;
Constant OPTIONAL_FLEXIBLE_INVENTORY;
!Constant OPTIONAL_LANGUAGE_NUMBER;
!Constant OPTIONAL_LIST_TOGETHER;
!Constant OPTIONAL_PRINT_SCENERY_CONTENTS;
Constant RUNTIME_ERRORS = 2; ! 0, 1 or 2. 0 = smallest file, 2 = most info

! Define any library constants you need here, like MAX_SCORE, AMUSING_PROVIDED,
! MAX_CARRIED, SACK_OBJECT,  etc.

Constant INITIAL_LOCATION_VALUE = Library;

Include "globals.h";

! Define your attributes, common properties and global variables here, if any

! Define the entry point routines you need here, like Amusing, DarkToDark etc.

Include "puny.h";

Verb 'tuttoriempi'
	* -> FillAll;

Verb 'tuttosvuota'
	* -> EmptyAll;

[FillAllSub x;
	objectloop(x provides buddy)
		move x.buddy to x;
	scope_modified = true;
	"Sposti cose dentro cose!";
];

[EmptyAllSub x y; 
	objectloop(x provides Buddy) {
		y = x.Buddy;
		if(y in x) move y to location;
	}
	scope_modified = true;
	"Sposti cose fuori da cose!";
];

Object Library "Biblioteca"
	with
        description "Biblioteca Canaglia.";

Object -> Table "tavolo"
	with
		name 'tavolo',
		describe [;
			print "^Un tavolo sta in mezzo alla stanza.";
			if(PrintContents(" Sul tavolo ", self, ISARE_BIT)) ".";
			new_line;
			rtrue;
		],
	has static supporter;

Object -> Chest "cesta"
	with 
		name 'cesta',
		buddy Book,
	has female container open openable;
	
Object -> Book "libro"
	with
		name 'libro';

Object -> GlassJar "giara di vetro"
	with 
		name 'giara' 'di' 'vetro',
		buddy Peach,
	has female container open openable transparent;
	
Object -> Peach "pesca"
	with
		name 'pesca'
		has female;

Object -> Bucket "secchio"
	with 
		name 'secchio',
		buddy Garbage,
	has container open;
	
Object -> Garbage "pattume"
	with
		article "del",
		name 'pattume';

Object -> GlassBowl "urna di vetro"
	with 
		name 'urna' 'di' 'vetro',
		buddy Onion,
	has female apostrofo container open transparent;
	
Object -> Onion "cipolla"
	with
		name 'cipolla'
		has female;

[Initialise;
	print "^^Proviamo PrintContents!^^
		Ogni contenitore ha un compagno oggetto. Puoi usare il comando TUTTORIEMPI
		per mettere tutti i compagni oggetti nei loro rispettivi contenitori, e
		TUTTOSVUOTA per toglierli dai contenitori e metterli per terra.^^"; 
];
