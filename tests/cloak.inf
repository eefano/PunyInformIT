!% -Cu
!% -~S
!% $OMIT_UNUSED_ROUTINES=1
!% $ZCODE_LESS_DICT_DATA=1

! The very first lines of the main source code file for a game can
! contain compiler options, like the lines above. -~S disables
! strict error checking. This is otherwise used in z5 and z8 games by
! default. While useful for debugging, it adds ~10 KB to the story file
! size and it makes the game slower.
! $OMIT_UNUSED_ROUTINES=1 makes the compiler remove all routines which
! aren't used. This can save some space.

! ============================================================================ !
!   Cloak of Darkness - a simple demonstration of Interactive Fiction
!	   This version for INFORM written by Roger Firth on 17Sep99
! ============================================================================ !

! When compiling to z8, use the standard library instead
#Iftrue (#version_number == 8);
Constant USEINFORM;
Constant MANUAL_PRONOUNS;
#Endif;

Constant Story	  "Il Mantello Delle Tenebre";
Constant Headline   "^Un'avventura dimostrativa.^";
Constant MAX_SCORE  2;
Constant OPTIONAL_EXTENDED_METAVERBS;

Release 3;
Serial "221116";

Constant STATUSLINE_SCORE; Statusline score;
Constant INITIAL_LOCATION_VALUE = foyer;

[ DeathMessage; print "Hai perso"; ];


#Ifndef USEINFORM;

Include "globals.h";
Include "puny.h";

#Endif;

#Ifdef USEINFORM;

Include "Parser";
Include "VerbLib";

#Endif;

! ============================================================================ !

Object  foyer "Foyer del Teatro"
  with  description
		   "Sei in una sala spaziosa, splendidamente decorata in rosso
			e oro. Sontuosi lampadari luccicano sulla tua testa. L'uscita verso la strada
			è a nord, ci sono corridoi a sud e a est.^^
			Una statua è stata collocata nel lato ovest della stanza.",
		s_to  bar,
		w_to  cloakroom,
		n_to
		   "Sei qui solo da poco tempo e, onestamente, il tempo fuori si sta facendo brutto.",
  has   light;

Object -> west_statue "statua a ovest"
	with
		description "Una bella statua di Medusa.",
		name 'west' 'statue' 'medusa',
		! parse_name to allow any combination of "west" "medusa" "statue" in that order
		parse_name [ _w _n;
			_w = NextWord();
			if(_w == 'ovest'){ _n++; _w = NextWord(); }
			if(_w == 'medusa'){ _n++; _w = NextWord(); }
			if(_w == 'statua')_n++;
			return _n;
		],
		before [;
			Examine: rfalse;
			PushDir: 
				"Provi a spingere la statua verso ", (name) Directions, ", senza riuscirci.";
			default: "Meglio lasciarla dov'è!";
		],
	has female static scenery;

Object  cloakroom "Guardaroba"
  with  description
		   "I muri di questa piccola stanza erano pieni di ganci per gli abiti,
			ma ora ne rimane solo uno. La porta d'uscita è a est.",
		e_to  foyer,
  has   light;

Object  hook "piccolo gancio di ottone" cloakroom
  with  name 'piccolo' 'gancio' 'di' 'ottone',
		description [;
			print "È solo un piccolo gancio di ottone, ";
			if (self == parent(cloak)) "con un mantello appeso su.";
			"screwed to the wall.";
		],
  has   scenery supporter;

Object  bar "Bar del Foyer"
  with  description
		   "A differenza dell'opulenza del Foyer, 
			 il bar è modesto e anche completamente deserto.
			 Sembra ci sia una specie di messaggio scarabocchiato
			 nella segatura del pavimento.",
		n_to  foyer,
		before [ _test;
			Look, Inv, Going:
				rfalse;
			Go:
#ifdef USEINFORM;
				_test = self hasnt light && noun ~= n_obj;
#IfNot;
				_test = self hasnt light && selected_direction ~= n_to;
#EndIf;
				if (_test) {
					message.number = message.number + 2;
					"Non è una buona idea aggirarsi maldestramente nel buio!";
				}
			default:
				if (self hasnt light) {
					message.number = message.number + 1;
					"Nel buio? Potresti turbare facilmente qualcuno!";
				}
		],
  has   ~light;

Object  cloak "mantello di velluto"
  with
		parse_name [ _words;
			while(NextWord() == 'grazioso' or 'scuro' or 'nero' or 'velluto' or 'seta' or 'mantello') _words++;
			return _words;
		],
!		name 'handsome' 'dark' 'black' 'velvet' 'satin' 'cloak',
		description
		   "Un grazioso mantello di velluto e seta, leggermente cosparso di gocce di pioggia.
			Il suo colore nero è così intenso che sembra quasi succhiare la luce dalla stanza..",
		before [;
			Drop, PutOn:
				if (location ~= cloakroom)
				   "Non è saggio lasciare in giro un mantello senziente.";
		],
		after [;
			Take: give bar ~light;
			Drop, PutOn:
				if (location == cloakroom) {
					give bar light;
					if (action == ##PutOn && self has general) {
						give self ~general;
						score++;
						}
					}
		],
  has   clothing general;

Object  message "messaggio scarabocchiato" bar
  with  name 'messaggio' 'segatura' 'pavimento',
		description [;
			if (self.number < 2) {
				score++;
				deadflag = 2;
				print "Il messaggio, ben marcato nella segatura, dice...";
				}
			else {
				deadflag = 3;
				print "Il messaggio è stato calpestato sbadatamente, rendendolo
				  poco leggibile. Puoi solo distinguere le parole...";
				}
		],
		number  0,
  has   scenery;

[ Initialise;
#Ifdef USEINFORM; ! The location is set with INITIAL_LOCATION_VALUE in PunyInform
	location = foyer;
#Endif;
	move cloak to player;
	give cloak worn;
   "^^Correndo trafelato sotto la pioggia notturna di novembre, vedi con sollievo
	le intense luci del Teatro dell'Opera. Fa strano non vedere tante persone in giro, ma 
	d'altronde cosa ti aspetti da un gioco così modesto?^^";
];


! ============================================================================ !


#Ifdef USEINFORM;
Include "Grammar";
#Endif;

Verb 'hang'	 * held 'on' noun	-> PutOn;

! ============================================================================ !
