!% -Cu
! Testing that held and creature tokens parse all/all-but correctly
! Testing issue 60 (sentence splitting)
! 
!
#Iftrue (#version_number == 8);
Constant USEINFORM;
#Endif;

Constant Story      "UnnknownVerb test";
Constant Headline   "^Un test per PunyInformIT.^";
Serial "200827";
Constant INITIAL_LOCATION_VALUE = Park;

! Uncomment to show time instead of score/turns
!Statusline time;

!Constant DEBUG;
!Constant DEBUG_PARSEANDPERFORM;
!Constant DEBUG_PARSEPATTERN;
!Constant DEBUG_PARSETOKEN;
!Constant DEBUG_PARSENOUNPHRASE;
!Constant DEBUG_GETNEXTNOUN;
!Constant DEBUG_SCOPE;

! Uncomment to add optional features to PunyLib
!Constant DEBUG;
!Constant CUSTOM_ABBREVIATIONS;
!Constant OPTIONAL_ALLOW_WRITTEN_NUMBERS;
Constant OPTIONAL_EXTENDED_METAVERBS;
!Constant OPTIONAL_EXTENDED_VERBSET;
!Constant OPTIONAL_FULL_SCORE;
!Constant OPTIONAL_FULL_DIRECTIONS;
!Constant OPTIONAL_GUESS_MISSING_NOUN;
!Constant OPTIONAL_MANUAL_SCOPE;
!Constant RUNTIME_ERRORS = 0;

#Ifdef USEINFORM;
Include "Parser";
Include "VerbLib";
#IfNot;
Include "globals.h";
#EndIf;

[ UnknownVerb word _p _i; 
    ! verb_wordnum: location of 'word' in parse array (usually 1)
    ! _p: 'word's parse array block
    ! _p->2: number of characters in the word
    ! _p->3: start of word in buffer array
    print "UnknownVerb '";
    _p = 2 + parse + 4 * (verb_wordnum - 1);
    for(_i = 0: _i < _p->2: _i++) {
        print (char) buffer->(_i + _p->3);
    }
    print "': ";
    if(word == 'xyzzy') {
        print "ho cambiato 'xyzzy' in 'esamina'^";
        return 'esamina';
    }
    print "non è xyzzy, rimane sconosciuto^";
    rfalse;
];

#Ifndef USEINFORM;
Include "puny.h";
#EndIf;


! Uncomment to add PunyLib extensions
!Include "ext_menu.h";
!Include "ext_flags.h";
!Include "ext_quote_box.h";
!Include "ext_cheap_scenery.h";


#Ifdef USEINFORM;
Include "Grammar";
#Endif;

Object Park "Parco"
   with description "Sei in un parco. C'è una panca di legno e una di pietra qui. Puoi andare a sud.",
   s_to Room,
has light;

Object Room "Stanza"
   with description "Sei in una stanza. C'è una panca di legno qui. Puoi andare a nord.",
   n_to Park,
has light;

Object red_coat "giacca rossa" selfobj
   with
      name 'giacca' 'rossa',
      description "una giacca rossa",
   has female clothing;

Object blue_coat "giacca blu" Park
   with
      name 'giacca' 'blu',
      description "una giacca blu",
   has female clothing;

Object wooden_bench "panca di legno" Park
   with
      name 'panca' 'di' 'legno',
      description "una panca di legno",
   has female scenery enterable;

Object stone_bench "panca di pietra" Park
   with
      name 'panca' 'di' 'pietra',
      description "una panca di pietra",
   has female scenery enterable;

Object wooden_bench2 "panca di legno" Room
   with
      name 'panca' 'di' 'legno',
      description "una panca di legno",
   has female scenery enterable;

Object stone_bench2 "panca di pietra" Room
   with
      name 'panca' 'di' 'pietra',
      description "una panca di pietra",
   has female enterable;

Object coffre_noir "baule nero" Park
with
   parse_name [;
      if (NextWord() ~= 'baule') return 0;
      if (NextWord() == 'nero') return 2;
      return 1;
   ],
   description "È un baule nero.",
has container openable ~open;

Object coffre_blanc "baule bianco" Park
with
   parse_name [;
      if (NextWord() ~= 'baule') return 0;
      if (NextWord() == 'bianco') return 2;
      return 1;
   ],
   description "È un baule bianco.",
has container openable ~open;

[ Initialise;
#IfDef USEINFORM;
    location=INITIAL_LOCATION_VALUE;
#EndIf;
];

