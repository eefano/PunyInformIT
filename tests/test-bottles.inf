!% -~S
!% $OMIT_UNUSED_ROUTINES=1
!% $ZCODE_LESS_DICT_DATA=1

#Iftrue (#version_number == 8);
Constant USEINFORM;
#Endif;

Constant Story      "Lattine";
Constant Headline   "^Test di PunyInformIT.^";

Constant STATUSLINE_SCORE; Statusline score;

Constant NO_SCORE = 0;

!Constant DEBUG; ! Provides debug verbs for both Inform and PunyInform
!Constant DEBUG_PARSEANDPERFORM;
!Constant DEBUG_PARSEPATTERN;
!Constant DEBUG_PARSETOKEN;
!Constant DEBUG_GETNEXTNOUN;
!Constant DEBUG_PARSENOUNPHRASE;

! Uncomment to add optional features to PunyInform
Constant RUNTIME_ERRORS = 2; ! 0, 1 or 2. 0 = smallest file, 2 = most info

Constant OPTIONAL_LIST_TOGETHER;
Constant OPTIONAL_LANGUAGE_NUMBER; ! Use this to have list_together print numbers using words
Constant OPTIONAL_ALLOW_WRITTEN_NUMBERS; ! Cheaper to add when OPTIONAL_LANGUAGE_NUMBER is defined

Constant OPTIONAL_EXTENDED_METAVERBS;
Constant OPTIONAL_EXTENDED_VERBSET;
Constant OPTIONAL_FLEXIBLE_INVENTORY;

Constant INITIAL_LOCATION_VALUE = Room;

#Ifdef USEINFORM;
Include "Parser";
Include "VerbLib";
#IfNot;
Include "globals.h";
#EndIf;

#Ifndef USEINFORM;
Include "puny.h";
#EndIf;

#Ifdef USEINFORM;
Include "Grammar";
#Endif;

Object Room "Stanza"
	with
		description "Sei in una stanza."
	has light;

Object -> Girl "ragazza"
    with
        name 'ragazza',
    has animate female;

Object -> GreenCan "lattina verde"
	with
        name 'lattina' 'verde' 'lattine//p',
		description "La lattina verde è vuota.",
	has female open;

Object -> BrownCan "lattina marrone"
	with
        name 'lattina' 'marrone' 'lattine//p',
		description "La lattina marrone è vuota.",
	has female open;

[Initialise; 
#IfDef USEINFORM;
    location=INITIAL_LOCATION_VALUE;;
#EndIf;
    move BrownCan to player;
    move GreenCan to player;
];
